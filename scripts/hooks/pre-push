#!/usr/bin/env bash
# Hook git: запускается после `git push`, до отправки коммитов. Включается один раз: scripts/setup.sh
# При push в main: если изменился gen, собрать образ и отправить на Docker Hub.
# После этого GitHub Actions (.github/workflows/deploy-gen.yml) разворачивает его на VPS.
# Ошибка здесь отменяет push. Обойти hook: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
FILES=(gen compose.yml compose_gen.yml) # от них зависит образ gen

# git передаёт на вход по строке на каждую отправляемую ветку
while read -r _ local_sha remote_ref remote_sha; do
	[ "$remote_ref" = refs/heads/main ] || continue
	[[ $local_sha =~ ^0+$ ]] && continue # удаление ветки
	# gen не менялся — сборка не нужна (если сравнить не с чем, собираем)
	git diff --quiet "$remote_sha" "$local_sha" -- "${FILES[@]}" 2>/dev/null && continue

	# образ собирается из файлов в папке, поэтому они должны совпадать с отправляемым коммитом
	if [ "$local_sha" != "$(git rev-parse HEAD)" ] || [ -n "$(git status --porcelain -- "${FILES[@]}")" ]; then
		echo "pre-push: есть незакоммиченные изменения (${FILES[*]}) или отправляется не текущий коммит. Push отменён." >&2
		exit 1
	fi
	echo "pre-push: gen изменился, собираю образ и отправляю на Docker Hub…"
	scripts/prepare.sh gen </dev/null # </dev/null: чтобы docker не прочитал список веток
done
