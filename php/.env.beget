APP_ENV=production
APP_DEBUG=false
APP_URL=https://tango-tambov.ru

LOG_LEVEL=warning

SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Адреса gen для выпадающего списка (через запятую; первый — по умолчанию). Отдаются сайтом по /gens.
# Production: и Beget, и VPS (compose.yml берёт этот файл как env_file). Браузер ходит к gen напрямую,
# поэтому только https: на https-странице http/ws блокируются как mixed content.
GEN_ORIGINS=https://155-212-190-33.sslip.io,https://blender-gen-render.onrender.com
